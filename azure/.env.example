# YPYW Business Intelligence - environment configuration template
# Copy this file to ".env" and fill in real values. NEVER commit the real .env.
# The .env file is gitignored.

# --- Azure SQL Database connection ---
# Logical SQL server FQDN
SQL_SERVER=ypyw-sql-ahmedsohail.database.windows.net

# Database name
SQL_DATABASE=ypyw-bi-db

# SQL administrator login
SQL_ADMIN_USER=ypywadmin

# SQL administrator password (DO NOT commit a real value)
SQL_ADMIN_PASSWORD=replace-with-your-password

# --- Optional: ODBC driver name used by the Python ingest (dataingest.py) ---
# Defaults to "ODBC Driver 18 for SQL Server" if unset.
SQL_DRIVER=ODBC Driver 18 for SQL Server

# --- Optional: base directory the Python file watcher monitors (dataingest.py) ---
# Defaults to a "YourPaintingYourWay" folder next to dataingest.py if unset.
# YPYW_BASE_DIR=./YourPaintingYourWay

# --- .NET (CPA.Web) connection string ---
# The .NET app reads ConnectionStrings:YpywDatabase. Provide it via this
# environment variable (note the double underscore). Do not hardcode the password.
ConnectionStrings__YpywDatabase=Server=tcp:ypyw-sql-ahmedsohail.database.windows.net,1433;Database=ypyw-bi-db;User ID=ypywadmin;Password=replace-with-your-password;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
