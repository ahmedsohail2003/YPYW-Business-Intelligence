@page "/estimates"
@using CPA.Shared.Models
@using CPA.Shared.Services
@inject EstimateService EstimateService

<PageTitle>YPYW · Estimates</PageTitle>

<h3>All Estimates</h3>

@if (loading)
{
    <p><em>Loading…</em></p>
}
else if (loadError is not null)
{
    <p class="text-muted">
        No database connected — provision with <code>azure/deploy.ps1</code>, seed with
        <code>python azure/seed_sample_data.py</code>, and set <code>ConnectionStrings__YpywDatabase</code>.
    </p>
}
else
{
    <p class="text-muted">@estimates!.Count estimates</p>
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Client</th>
                <th>Status</th>
                <th>Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in estimates)
            {
                <tr>
                    <td>@job.DocumentId</td>
                    <td>@job.ClientName</td>
                    <td>@job.Status</td>
                    <td>@job.EstimateAmount?.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Estimate>? estimates;
    private bool loading = true;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            estimates = await EstimateService.GetEstimatesAsync();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }
}
